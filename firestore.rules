rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============ HELPER FUNCTIONS ============
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isValidRating(value) {
      return value is number && value >= 0 && value <= 10;
    }

    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    // ============ USER PROFILES ============
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId)
                    && hasOnlyAllowedFields(['displayName', 'email', 'photoURL', 'avatarCharacter', 'createdAt', 'updatedAt'])
                    && isValidString(request.resource.data.displayName, 100);
      allow update: if isOwner(userId)
                    && hasOnlyAllowedFields(['displayName', 'photoURL', 'avatarCharacter', 'updatedAt'])
                    && (!('displayName' in request.resource.data) || isValidString(request.resource.data.displayName, 100));
      allow delete: if isOwner(userId);

      // Watchlist subcollection
      match /watchlist/{itemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && hasOnlyAllowedFields(['mediaType', 'tmdbId', 'title', 'posterPath', 'addedAt'])
                              && request.resource.data.mediaType in ['movie', 'tv'];
        allow delete: if isOwner(userId);
      }

      // Ratings subcollection
      match /ratings/{itemId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
                              && hasOnlyAllowedFields(['mediaType', 'tmdbId', 'rating', 'ratedAt'])
                              && isValidRating(request.resource.data.rating)
                              && request.resource.data.mediaType in ['movie', 'tv'];
        allow delete: if isOwner(userId);
      }
    }

    // ============ BATTLES ============
    match /battles/{battleId} {
      allow read: if true; // Public — anyone can view battles
      allow write: if false; // Only admin/server can create battles

      match /votes/{voteId} {
        // One vote per user per battle — voteId must equal userId
        allow read: if true;
        allow create: if isAuthenticated()
                      && voteId == request.auth.uid
                      && hasOnlyAllowedFields(['choice', 'votedAt', 'userId'])
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.choice is string;
        allow update, delete: if false; // No vote changes after cast — prevents vote manipulation
      }
    }
    
    // ============ SYSTEM ============
    match /system/{document} {
      allow read: if true;
      allow write: if false; // Only admin can update system docs
    }

    // ============ TOP100VOTES ============
    match /top100votes/{movieId} {
      allow read: if true;
      allow write: if false;

      match /votes/{userId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // ============ DEFAULT DENY ============
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
