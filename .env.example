# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# TMDB API (The Movie Database)
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_TMDB_READ_TOKEN=your_tmdb_read_token_here

# OMDb API (For Rotten Tomatoes Scores)
VITE_OMDB_API_KEY=your_omdb_api_key_here

# Watchmode API (For streaming availability)
VITE_WATCHMODE_API_KEY=your_watchmode_api_key_here

# EmailJS (For Contact Forms)
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Beehiiv Newsletter (For newsletter signup embed)
# Get the form ID from your Beehiiv dashboard → Forms → embed code
# IMPORTANT: Must also be set in Hostinger Environment Variables for production
# (Vite bakes VITE_* env vars at build time — GitHub Secrets alone will NOT work)
VITE_BEEHIIV_FORM_ID=your_beehiiv_form_id_here