# ============================================
# CINEMADISCOVERY SECURITY + PERFORMANCE .HTACCESS
# ============================================

# ---- Preserve LiteSpeed LSCWP fix (2026-04-29) ----
<IfModule LiteSpeed>
  CacheDisable public /
</IfModule>

<IfModule mod_headers.c>
  # Suppress Alt-Svc to fix ERR_QUIC_PROTOCOL_ERROR
  Header unset Alt-Svc
  Header always unset Alt-Svc
</IfModule>

# ---- Server fingerprint removal ----
ServerSignature Off
<IfModule mod_security.c>
  SecServerSignature " "
</IfModule>

# ---- Directory browsing disabled ----
Options -Indexes

# ---- HTTP Security Headers ----
<IfModule mod_headers.c>
  # HSTS — force HTTPS for 1 year, include subdomains, allow preload
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Clickjacking prevention
  Header always set X-Frame-Options "SAMEORIGIN"

  # MIME-type sniffing prevention
  Header always set X-Content-Type-Options "nosniff"

  # Legacy XSS protection (modern browsers ignore but harmless for older ones)
  Header always set X-XSS-Protection "1; mode=block"

  # Referrer policy — send origin only on cross-origin requests
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy — disable unneeded browser APIs
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=()"

  # Content Security Policy — strict but allows all required external services.
  # WARNING: Modifying this without testing can break Firebase Auth (Google popup),
  # TMDB image loading, YouTube embeds, or EmailJS. Test all integrations after changes.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com https://apis.google.com https://accounts.google.com https://www.gstatic.com https://*.firebaseapp.com https://cdn.emailjs.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https://image.tmdb.org https://*.tmdb.org https://www.google-analytics.com https://*.googleusercontent.com https://lh3.googleusercontent.com https://i.ytimg.com; connect-src 'self' https://api.themoviedb.org https://image.tmdb.org https://www.omdbapi.com https://*.firebaseio.com https://*.googleapis.com https://firestore.googleapis.com https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://www.google-analytics.com https://analytics.google.com https://api.emailjs.com https://accounts.google.com; frame-src 'self' https://*.firebaseapp.com https://accounts.google.com https://www.youtube.com https://www.youtube-nocookie.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # Cross-Origin policies
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header always set Cross-Origin-Resource-Policy "cross-origin"
</IfModule>

# ---- Block sensitive files ----
<FilesMatch "^\.|composer\.(json|lock)|package(-lock)?\.json|yarn\.lock|\.env.*|\.git.*|\.htaccess$|\.htpasswd$|README\.md|AGENTS\.md|firestore\.rules|firebase\.json|vite\.config\.ts|tsconfig.*\.json">
  Require all denied
</FilesMatch>

# ---- Block bad bots and scrapers ----
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Block known bad bots by user-agent
  RewriteCond %{HTTP_USER_AGENT} (ahrefsbot|semrushbot|mj12bot|dotbot|petalbot|blexbot|seznambot|exabot|gigabot|megaindex|serpstatbot|barkrowler|riddler|dataforseo|zoominfobot|pricepi|sqlmap|nikto|wpscan|nessus|openvas|w3af|skipfish|arachni|curl|wget|libwww|python-requests|scrapy|httpclient|java/) [NC]
  RewriteRule .* - [F,L]

  # ---- SPA routing ----
  # The following rewrite cascade is critical for React Router to work on a static host.
  # Order matters: existing-file check → directory index → prerendered route → SPA fallback.
  # Fixed 2026-05-21: added !-f / !-d guards and html to excluded-extensions list to prevent
  # the infinite rewrite loop (LiteSpeed re-ran the ruleset on /path/index.html, which still
  # matched all three URI conditions, causing /path/index.html/index.html/… → HTTP 500).

  # Strip trailing slash from non-file URLs (force React Router to handle them)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]

  # 1. Serve real files directly (CSS, JS, images, prerendered HTML, fonts, etc.)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Serve existing directories with their own index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+)$ /$1/index.html [L]

  # 3. For non-file, non-directory, non-asset URLs: serve the prerendered /path/index.html
  #    html is now excluded so /path/index.html does NOT re-trigger this rule (loop fix).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.(css|js|jpg|jpeg|png|gif|webp|svg|ico|json|xml|txt|woff|woff2|ttf|eot|map|html)$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # 4. Final fallback: serve React Router SPA shell for any unmatched route
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ /index.html [L]
</IfModule>

# ---- Preserve existing Cache-Control headers ----
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|json|xml)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- Gzip compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
